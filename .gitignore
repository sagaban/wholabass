# Build output
dist/
src-tauri/target/
target/

# Dependencies
node_modules/
.venv/
ml/.venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# User data
library/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# TypeScript build info
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Tauri
src-tauri/gen/
src-tauri/WixTools/

# Sidecar binaries — stubs created by scripts/ensure-sidecar-stubs.sh
# (run from `pnpm prepare`); real binaries built by build-sidecar.sh
# on `tauri build`. Neither belongs in version control.
src-tauri/binaries/wholabass-server-*
src-tauri/binaries/ffmpeg-*

# PyInstaller output — ml/build is the intermediate cache, ml/dist
# holds the freshly compiled `wholabass-server` binary before it's
# staged under src-tauri/binaries/. Both regen on every build-sidecar
# run; nothing in either dir is editable source.
ml/build/
ml/dist/

# Panda CSS (regenerated by `panda codegen` / `prepare`)
styled-system/
styled-system-studio/
